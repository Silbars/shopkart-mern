PORT=5001
# Option A: Full Connection String (Username & Password protected)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shopkart?retryWrites=true&w=majority

# Option B: Separate Environment Variables (Automatically assembled in index.js)
# DB_USER=your_db_username
# DB_PASSWORD=your_db_password
# DB_HOST=cluster0.xxxxx.mongodb.net
# DB_NAME=shopkart

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
NODE_ENV=development
